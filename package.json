{
  "name": "nanthai-edge",
  "version": "1.0.0",
  "private": true,
  "description": "NanthAI Edge — source-available web client and Convex backend",
  "scripts": {
    "dev": "convex dev",
    "test": "npm run convex:test",
    "lint": "npm run convex:lint && npm --prefix web run lint",
    "convex:test": "tsx --test convex/tests/*.test.ts",
    "convex:test:coverage": "c8 --all --include='convex/**/*.ts' --exclude='convex/_generated/**' --exclude='convex/tests/**' --exclude='convex/skills/catalog/**' --exclude='convex/**/*_types.ts' --exclude='convex/auth.config.ts' --exclude='convex/convex.config.ts' --reporter=text --reporter=lcov npx tsx --test convex/tests/*.test.ts",
    "convex:coverage:audit": "node scripts/convex_coverage_audit.mjs",
    "convex:lint": "eslint convex --ext .ts",
    "convex:typecheck": "tsc --noEmit --project convex/tsconfig.json",
    "deploy": "convex deploy",
    "deploy:prod": "convex deploy --yes --typecheck disable"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@convex-dev/agent": "^0.6.1",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.0",
    "@vercel/sandbox": "^1.9.3",
    "ai": "^6.0.180",
    "convex": "^1.38.0",
    "convex-helpers": "^0.1.116",
    "docx": "^9.6.0",
    "imapflow": "^1.3.2",
    "just-bash": "^2.14.0",
    "mailparser": "^3.9.8",
    "nodemailer": "^8.0.6",
    "pptxgenjs": "^4.0.1",
    "pyodide": "^0.29.3",
    "tsdav": "^2.1.8",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/web-push": "^3.6.4",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
