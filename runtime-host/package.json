{
  "name": "@nanthai/runtime-host",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "bin": {
    "nanthai": "bin/nanthai.mjs"
  },
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:release": "node --test scripts/release-macos.test.mjs",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:release",
    "nanthai": "tsx src/cli_entry.ts",
    "build:package": "node scripts/build-package.mjs",
    "release:macos": "node scripts/release-macos.mjs"
  },
  "dependencies": {
    "convex": "1.46.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "esbuild": "0.27.7",
    "tsx": "4.21.0"
  }
}
